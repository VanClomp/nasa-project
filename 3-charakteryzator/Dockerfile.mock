# ⚠️ UWAGA: Dockerfile uruchamiający TYMCZASOWY MOCK HEURYSTYCZNY 3-charakteryzator
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY MOCK_HEURYSTYKA_charakteryzator_api.py .

EXPOSE 8001
CMD ["uvicorn", "MOCK_HEURYSTYKA_charakteryzator_api:app", "--host", "0.0.0.0", "--port", "8001"]
